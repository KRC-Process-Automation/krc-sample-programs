// Buffered inputs, the state machine, the outputs, and the timers. Each line says which program
// writes it: one writer per variable, so any value can be traced back with one search.
VAR_GLOBAL
	iStep             : E_Step := S0_IDLE;	// The step the machine is in (STATE_MACHINE)
	iNextStep         : E_Step := S0_IDLE;	// The step it goes to at the end of this scan (STATE_MACHINE)
	iStepAtScanStart  : E_Step := S0_IDLE;	// The step the machine was in when this scan started, for the alarm lines (STATE_MACHINE)
	sStateDescription : STRING(80) := 'Idle';	// What the machine is doing, in words (STATE_MACHINE)
	bStartPB          : BOOL;	// Start pressed, on the panel or the HMI (INPUTS)
	bStopPB           : BOOL;	// Stop pressed, on the panel or the HMI (INPUTS)
	bResetPB          : BOOL;	// Reset pressed, on the panel or the HMI (INPUTS)
	bDriveReady       : BOOL;	// The drive is ready (INPUTS)
	bDriveRemote      : BOOL;	// The drive is in remote (INPUTS)
	bEStopOK          : BOOL;	// The E-stop circuit is closed (INPUTS)
	iSpeedFbk         : INT;	// Motor speed feedback in % (INPUTS)
	rtStart           : R_TRIG;	// One-shot: TRUE for one scan when Start is pressed (INPUTS)
	rtReset           : R_TRIG;	// One-shot: TRUE for one scan when Reset is pressed (INPUTS)
	rtAck             : R_TRIG;	// One-shot: TRUE for one scan when ACK is pressed (INPUTS)
	bMotorRun         : BOOL;	// Motor run command (DEVICES)
	iSpeedRef         : INT;	// Motor speed reference in % (DEVICES)
	bStackGreen       : BOOL;	// Stack light green (DEVICES)
	bStackRed         : BOOL;	// Stack light red (DEVICES)
	bStackOrange      : BOOL;	// Stack light orange (DEVICES)
	bStartLamp        : BOOL;	// Start button lamp (DEVICES)
	bStopLamp         : BOOL;	// Stop button lamp (DEVICES)
	bResetLamp        : BOOL;	// Reset button lamp (DEVICES)
	bAckLamp          : BOOL;	// ACK button lamp (DEVICES)
	bFlash            : BOOL;	// Flips every T_FLASH, for the orange light (DEVICES)
	TON_Flash         : TON;	// On-delay timer that restarts itself: the flasher (DEVICES)
	TON_RAMP_10       : TON;	// On-delay timer: timeout for the ramp to 10 % (ALARMS)
	TON_RAMP_25       : TON;	// On-delay timer: timeout for the ramp to 25 % (ALARMS)
	TON_RAMP_50       : TON;	// On-delay timer: timeout for the ramp to 50 % (ALARMS)
	TON_RAMP_75       : TON;	// On-delay timer: timeout for the ramp to 75 % (ALARMS)
	TON_STOPPING      : TON;	// On-delay timer: timeout for the motor to stop (ALARMS)
	TON_SpeedDeviation : TON;	// On-delay timer: how long the speed has been off its reference at speed (ALARMS)
END_VAR
